      title="Modelado"
      tools={[
        {
          name: "Diagrama entidad-relación",
          description: "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
          href: "https://example.com/modelado-1",
          icon: "mingcute:file-line"
        },
        {
          name: "Diagrama relacional",
          description: "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
          href: "https://example.com/modelado-2",
          icon: "mingcute:file-line"
        }
      ]}
    />
    <ToolSection
      title="Normalización"
      tools={[
        {
          name: "Proceso de normalización (1FN-3FN)",
          description: "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
          href: "https://example.com/normalizacion-1",
          icon: "mingcute:file-line"
        },
        {
          name: "Tablas normalizadas",
          description: "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
          href: "https://example.com/normalizacion-2",
          icon: "mingcute:file-line"
        }
      ]}
    />
