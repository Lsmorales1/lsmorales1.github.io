        src: "/proyecto/Script Usuarios.sql",
        type: "link",
      },
    ],
  },
  {
    title: "Análisis e implementación",
    items: [
      {
        name: "Análisis RDBMS",
        description: "Selección del motor de base de datos.",
        src: "/proyecto/Analisis RDBMS.pdf",
        type: "pdf",
      },
