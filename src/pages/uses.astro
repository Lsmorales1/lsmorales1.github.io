---

<CommonLayout
  title="Evidencias"
  description={evidenciasDescription}
  modifiedTime={new Date()}
  breadcrumbs={[{ label: "Evidencias", icon: "file" }]}
  prose={false}
>
  {
    sections.map((section) => (
      <section class="ev-section">
        <h2>{section.title}</h2>
        <div class="ev-grid">
          {section.items.map((item) => {
            const url = encodeURI(item.src)
            return item.type === "link" ? (
              <a class="ev-card" href={url} target="_blank" rel="noopener">
                <span class="ev-badge">Archivo</span>
                <strong>{item.name}</strong>
                <span class="ev-desc">{item.description}</span>
              </a>
            ) : (
              <button
                type="button"
                class="ev-card"
                data-visor
                data-src={url}
                data-type={item.type}
                data-title={item.name}
              >
                {item.type === "image" ? (
                  <img src={url} alt={item.name} loading="lazy" />
                ) : (
                  <span class="ev-badge">PDF</span>
                )}
                <strong>{item.name}</strong>
                <span class="ev-desc">{item.description}</span>
              </button>
            )
          })}
        </div>
      </section>
    ))
  }

  <dialog id="visor">
    <div class="visor-wrap">
      <div class="visor-bar">
        <span class="visor-title"></span>
        <a class="visor-open" href="#" target="_blank" rel="noopener">
          Abrir en pestaña nueva
        </a>
        <button type="button" class="visor-close" aria-label="Cerrar">
          ✕
        </button>
      </div>
      <div class="visor-body"></div>
    </div>
  </dialog>
</CommonLayout>

<style>
  .ev-section {
    margin-bottom: 2.5rem;
  }
  .ev-section h2 {
    margin-bottom: 1rem;
    font-size: 1.4rem;
    font-weight: 600;
  }
  .ev-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }
  .ev-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.75rem;
    text-align: left;
    color: inherit;
    text-decoration: none;
    font: inherit;
    cursor: pointer;
    background: transparent;
    border: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    border-radius: 0.75rem;
    transition:
      transform 0.15s ease,
      border-color 0.15s ease;
  }
  .ev-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, currentColor 50%, transparent);
  }
  .ev-card img {
    width: 100%;
    height: 150px;
    object-fit: cover;
    border-radius: 0.5rem;
    background: color-mix(in srgb, currentColor 8%, transparent);
  }
  .ev-badge {
    display: grid;
    place-items: center;
    height: 150px;
    font-weight: 700;
    letter-spacing: 0.08em;
    border-radius: 0.5rem;
    background: color-mix(in srgb, currentColor 8%, transparent);
  }
  .ev-desc {
    font-size: 0.85rem;
    opacity: 0.7;
  }

  #visor {
    padding: 0;
    border: none;
    border-radius: 0.75rem;
    max-width: 95vw;
    max-height: 95vh;
    background: Canvas;
    color: CanvasText;
  }
  #visor::backdrop {
    background: rgb(0 0 0 / 0.75);
  }
  .visor-wrap {
    display: flex;
    flex-direction: column;
  }
  .visor-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 20%, transparent);
  }
  .visor-title {
    flex: 1;
    font-weight: 600;
  }
  .visor-open {
    font-size: 0.85rem;
  }
  .visor-close {
    font: inherit;
    font-size: 1.1rem;
    color: inherit;
    cursor: pointer;
    background: none;
    border: none;
  }
  .visor-body {
    display: grid;
    place-items: center;
    padding: 0.5rem;
    overflow: auto;
  }
  .visor-body :global(img) {
    max-width: 90vw;
    max-height: 80vh;
    object-fit: contain;
  }
  .visor-body :global(iframe) {
    width: 90vw;
    height: 80vh;
    border: none;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#visor")
  const body = dialog?.querySelector<HTMLElement>(".visor-body")
  const title = dialog?.querySelector<HTMLElement>(".visor-title")
  const openLink = dialog?.querySelector<HTMLAnchorElement>(".visor-open")
  const closeBtn = dialog?.querySelector<HTMLElement>(".visor-close")

  if (dialog && body && title && openLink) {
    for (const el of document.querySelectorAll<HTMLElement>("[data-visor]")) {
      el.addEventListener("click", () => {
        const { src = "", type, title: name = "" } = el.dataset
        let node: HTMLElement
        if (type === "pdf") {
          node = document.createElement("iframe")
          node.setAttribute("src", src)
          node.setAttribute("title", name)
        } else {
          node = document.createElement("img")
          node.setAttribute("src", src)
          node.setAttribute("alt", name)
        }
        body.replaceChildren(node)
        title.textContent = name
        openLink.href = src
        dialog.showModal()
      })
    }

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close()
    })
    closeBtn?.addEventListener("click", () => dialog.close())
    dialog.addEventListener("close", () => body.replaceChildren())
  }
</script>
