        name: "Relaciones MER",
        description: "Primeros ejercicios de práctica MER.",
        src: "/img/evidencias/Primeros ejercicios.jpeg",
        type: "image",
      },
      {
        name: "Diagrama relacional",
        description: "Modelo relacional de ConduCar.",
        src: "/proyecto/Relational_ConduCar.pdf",
        type: "pdf",
      },
      {
        name: "Diccionario de datos",
        description: "Generado con DataModeler.",
        src: "/proyecto/Diccionario de Datos DataModeler.pdf",
        type: "pdf",
      },
      {
        name: "Álgebra relacional",
        description: "Consultas en álgebra relacional.",
        src: "/proyecto/Algebra Relacional ConduCar.pdf",
        type: "pdf",
      },
    ],
  },
  {
    title: "Normalización",
    items: [
      {
        name: "Ejercicio de normalización 1FN",
        description: "Reglas de la primera forma normal.",
        src: "/docs/NORMALIZACION_ejer 3.pdf",
        type: "pdf",
      },
      {
        name: "Ejercicio de normalización: tienda",
        description: "Normalización sobre una tienda.",
        src: "/docs/NORMALIZACION_EJERCICIO_2.pdf",
        type: "pdf",
      },
      {
        name: "Ejercicio de normalización: centro médico",
        description: "Normalización sobre un centro médico.",
        src: "/docs/NORMALIZACION_ejer_1.pdf",
        type: "pdf",
      },
      {
        name: "Normalización ConduCar",
        description: "Hoja de cálculo del proceso (se descarga).",
        src: "/proyecto/Normalizacion_ConduCar.xlsx",
        type: "link",
      },
    ],
  },
  {
    title: "SQL",
    items: [
      {
        name: "Script crear tablas",
        description: "Script de creación (DDL).",
        src: "/proyecto/Script Crear Tablas.sql",
        type: "link",
      },
      {
        name: "Script insertar datos",
